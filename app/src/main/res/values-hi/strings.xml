    <string name="quality_enhanced">बेहतर</string>
    <string name="quality_enhanced_goal">संगीत के साथ चलने वाला जीवंत बैकग्राउंड</string>
    <string name="quality_enhanced_feature_1">\"अभी चल रहा है\" आपके कवर पर रहता है, जो हल्की रंगीन रोशनी बनकर स्क्रीन के किनारे तक फैला होता है, हर Android वर्शन पर</string>
    <string name="quality_enhanced_feature_2">बैकग्राउंड \"अभी चल रहा है\" में और पूरे ऐप में धीरे-धीरे बहता है, और कुछ न चलने पर फिर गहरा हो जाता है</string>
    <string name="quality_enhanced_feature_3">एक लाइट फ़ील्ड: कवर के अपने रंगों के तीन पुंज हर स्क्रीन पर उसके ऊपर तैरते हैं</string>
    <string name="quality_enhanced_feature_4">एज लाइट: कवर के हर किनारे का रंग उसके पीछे से छलकता है</string>
    <string name="quality_enhanced_feature_5">कवर से रंग: वेवफ़ॉर्म, इमेज के चारों ओर की रोशनी और उसकी छाया हर गाने से मेल खाती है</string>
    <string name="quality_enhanced_feature_6">रिएक्टिव कवर: कवर धड़कता है, बीट पर उससे शॉकवेव रिंग निकलती हैं और बैकग्राउंड बेस के साथ साँस लेता है</string>
    <string name="quality_enhanced_feature_7">फ़ोकस में बोल: गाई जा रही पंक्ति से दूर की पंक्तियाँ हल्की हो जाती हैं</string>
    <string name="quality_enhanced_feature_8">ज़्यादा साफ़ कवर, 72 बार वाला वेवफ़ॉर्म, और बारीक दाने जो रंगों की पट्टियाँ बनने से रोकते हैं</string>
    <string name="quality_premium">Premium</string>
    <string name="quality_premium_goal">झुकाए जा सकने वाले कवर, बीट के साथ चलती रोशनी</string>
    <string name="quality_premium_feature_1">बेहतर की सारी सुविधाएँ</string>
    <string name="quality_premium_feature_2">गहराई वाला पैरालैक्स: कवर आपके फ़ोन के साथ झुकता है, उस पर रोशनी फिसलती है, और बैकग्राउंड उसके पीछे एक अलग परत की तरह चलता है</string>
    <string name="quality_premium_feature_3">बैकग्राउंड बहते हुए घूमता भी है, यहाँ और पूरे ऐप में, और लाइट फ़ील्ड में चौथा पुंज जुड़ जाता है; रिएक्टिव कवर के साथ \"अभी चल रहा है\" में पुंज बेस पर बढ़ते हैं</string>
    <string name="quality_premium_feature_4">रिएक्टिव कवर: तेज़ बीट पर कवर पर रोशनी की एक चमक दौड़ती है</string>
    <string name="quality_premium_feature_5">गाई जा रही पंक्ति चमकती है</string>
    <string name="quality_premium_feature_6">\"अभी चल रहा है\" खुला रहने तक आपकी स्क्रीन का सबसे ऊँचा रिफ़्रेश रेट</string>
    <string name="quality_premium_feature_7">पूरे रिज़ॉल्यूशन वाले कवर, 96 बार वाला वेवफ़ॉर्म</string>
