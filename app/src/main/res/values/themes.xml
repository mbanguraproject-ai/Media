<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Splash: deep ink, the aperture on its lit disc, the wordmark. Both
         splash drawables come from tools/make_icon.py, the same geometry as
         the launcher icon. Here, below Android 12, it is still; values-v31
         has the animated one, where the iris turns in and opens. -->
    <style name="Theme.Media.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!-- Bottom wordmark. API 31+ only: core-splashscreen ignores this on
             older versions, which show the icon alone. Regenerate the PNG with
             tools/make_wordmark.py when the name or version changes. -->
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Media</item>
    </style>

    <!-- Main theme: fully edge-to-edge. No hardcoded bar colors (deprecated /
         ignored on Android 15+). Transparent bars + no system contrast scrim
         are declared here so they are correct before Compose mounts, which
         also removes the black cold-start flash against the cream splash. -->
    <style name="Theme.Media" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
