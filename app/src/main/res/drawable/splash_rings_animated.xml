<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_rings">

    <!-- Dot lands, then the rings push out from it. 700ms, inside the
         SplashScreen API ceiling. -->

    <target android:name="dot">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX"
                    android:valueFrom="0.2" android:valueTo="1" android:duration="260"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY"
                    android:valueFrom="0.2" android:valueTo="1" android:duration="260"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="pDot">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator android:propertyName="fillAlpha"
                android:valueFrom="0" android:valueTo="1" android:duration="200" />
        </aapt:attr>
    </target>
    <target android:name="ringIn">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX"
                    android:valueFrom="0.3" android:valueTo="1"
                    android:startOffset="150" android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleY"
                    android:valueFrom="0.3" android:valueTo="1"
                    android:startOffset="150" android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="pIn">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha"
                android:valueFrom="0" android:valueTo="0.55"
                android:startOffset="150" android:duration="300" />
        </aapt:attr>
    </target>
    <target android:name="ringOut">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX"
                    android:valueFrom="0.45" android:valueTo="1"
                    android:startOffset="280" android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator android:propertyName="scaleY"
                    android:valueFrom="0.45" android:valueTo="1"
                    android:startOffset="280" android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="pOut">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha"
                android:valueFrom="0" android:valueTo="0.32"
                android:startOffset="280" android:duration="300" />
        </aapt:attr>
    </target>
</animated-vector>
