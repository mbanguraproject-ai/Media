<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Back for ads only. The app itself still plays entirely from local
         storage and sends nothing anywhere. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Aura Share. Discovery is UDP multicast, and Wi-Fi hardware filters
         multicast away to save power unless a lock is held - without these
         the phone hears no replies at all, which looks exactly like an empty
         network. Nothing here reaches the internet; it is all on the LAN. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required on targetSdk 33+ for the advertising ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- API 24-32: the pre-Tiramisu media permission. Without this declared,
         the runtime request in requiredPermissions() is silently denied and
         the permission gate loops forever on Android 12 and below. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- API 24-28 only. From 29 a delete is asked for through the system
         rather than granted up front, so this must not be requested there. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Media.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9121922395304175~8852224517" />

        <!-- The phone is the server while Aura Share is running, so the
             process has to survive the user leaving the app. mediaPlayback is
             the right type: Android names casting in its own definition of
             it, and the permission is already declared for local playback. -->
        <service
            android:name=".ShareService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
